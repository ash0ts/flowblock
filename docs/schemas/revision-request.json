            "endCoverage": {
              "type": "number",
              "minimum": 0
            },
            "target": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "temporalStart": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
