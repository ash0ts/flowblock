          "required": [
            "lens",
            "aspectRatio",
            "stabilizer",
            "gimbalMode",
            "cameraRadius",
            "operatorRadius",
            "operatorOffset",
            "uncertaintyMargin",
            "minHeight",
            "maxHeight",
            "maxSpeed"
          ],
          "additionalProperties": false
        },
        "intent": {
          "type": "object",
          "properties": {
            "brief": {
              "default": "A controlled product hero shot",
              "type": "string",
              "maxLength": 4000
            },
            "durationSeconds": {
              "type": "number",
              "minimum": 2,
              "maximum": 60
            },
            "framing": {
              "type": "string",
              "enum": [
                "wide",
                "medium",
                "close"
              ]
            },
            "motion": {
              "type": "string",
              "enum": [
                "subtle",
                "balanced",
                "dynamic"
              ]
            },
            "cameraHeight": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 5
            },
            "framingTargets": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 1
                    },
                    {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 1
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "end": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 1
                    },
                    {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 1
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "brief",
            "durationSeconds",
            "framing",
            "motion",
            "cameraHeight"
          ],
          "additionalProperties": false
        },
        "overrides": {
          "type": "object",
          "properties": {
            "distance": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 30
            },
            "travel": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "bearingDeg": {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            },
            "orbitDegrees": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "height": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 5
            },
            "durationSeconds": {
              "type": "number",
              "minimum": 2,
              "maximum": 60
            },
            "reverse": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "path": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "hold",
                "line",
                "arc"
              ]
            },
            "start": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "z": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                }
              },
              "required": [
                "x",
                "z"
              ],
              "additionalProperties": false
            },
            "end": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "z": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                }
              },
              "required": [
                "x",
                "z"
              ],
              "additionalProperties": false
            },
            "center": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "z": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                }
              },
              "required": [
                "x",
                "z"
              ],
              "additionalProperties": false
            },
            "radius": {
              "type": "number",
              "minimum": 0
            },
            "startAngle": {
              "type": "number"
            },
            "sweepAngle": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "start",
            "end",
            "center",
            "radius",
            "startAngle",
            "sweepAngle"
          ],
          "additionalProperties": false
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "arcLength": {
          "type": "number",
          "minimum": 0
        },
        "cameraHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "validation": {
          "type": "object",
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "violations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "obstacleId": {
                    "type": "string"
                  },
                  "timeSeconds": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "code",
                  "severity",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "minClearance": {
              "type": "number"
            },
            "approximationError": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.01
            },
            "checkedSegments": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "model": {
              "type": "string"
            }
          },
          "required": [
            "valid",
            "violations",
            "minClearance",
            "approximationError",
            "checkedSegments",
            "model"
          ],
          "additionalProperties": false
