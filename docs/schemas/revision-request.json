              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  "z": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              "operator": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  "z": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  }
                },
                "required": [
                  "x",
                  "z"
                ],
                "additionalProperties": false
              },
              "target": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  "z": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              "yawDeg": {
                "type": "number"
              },
              "pitchDeg": {
                "type": "number"
              },
              "distance": {
                "type": "number",
                "minimum": 0
              },
              "coverage": {
                "type": "number",
                "minimum": 0
              },
              "framingBox": {
                "type": "object",
                "properties": {
                  "centerX": {
                    "type": "number"
                  },
                  "centerY": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "centerX",
                  "centerY",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "projectionValid": {
                "type": "boolean"
              },
              "progress": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "t",
              "timeSeconds",
              "position",
              "operator",
              "target",
              "yawDeg",
              "pitchDeg",
              "distance",
              "coverage",
              "framingBox",
              "projectionValid",
              "progress"
            ],
            "additionalProperties": false
          }
        },
        "score": {
          "type": "number"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "recipeId",
        "family",
        "name",
        "scene",
        "gear",
        "intent",
        "overrides",
        "path",
        "durationSeconds",
        "arcLength",
        "cameraHeight",
        "validation",
        "framing",
        "keyframes",
        "score"
      ],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "jobId"
      ],
      "additionalProperties": false
    },
    "overrides": {
      "type": "object",
      "properties": {
        "distance": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 30
        },
        "travel": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "bearingDeg": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "orbitDegrees": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "height": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 2,
          "maximum": 60
        },
        "reverse": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "findingIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "plan",
    "analysis"
  ],
  "additionalProperties": false,
  "$id": "https://flowblock.local/schemas/1.0/revision-request.json"
}
