{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scene": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "boundary": {
          "minItems": 3,
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1000,
                "maximum": 1000
              },
              "z": {
                "type": "number",
                "minimum": -1000,
                "maximum": 1000
              }
            },
            "required": [
              "x",
              "z"
            ],
            "additionalProperties": false
          }
        },
        "subject": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "center": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "z": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                }
              },
              "required": [
                "x",
                "z"
              ],
              "additionalProperties": false
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "depth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20
            },
            "baseHeight": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "yawDeg": {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            }
          },
          "required": [
            "id",
            "name",
            "center",
            "width",
            "depth",
            "height",
            "baseHeight",
            "yawDeg"
          ],
          "additionalProperties": false
        },
        "obstacles": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "center": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  "z": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  }
                },
                "required": [
                  "x",
                  "z"
                ],
                "additionalProperties": false
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "depth": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 20
              },
              "baseHeight": {
                "type": "number",
                "minimum": 0,
                "maximum": 20
              },
              "yawDeg": {
                "type": "number",
                "minimum": -360,
                "maximum": 360
              }
            },
            "required": [
              "id",
              "name",
              "center",
              "width",
              "depth",
              "height",
              "baseHeight",
              "yawDeg"
            ],
            "additionalProperties": false
          }
        },
        "lights": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  "z": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              "intensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "id",
              "name",
              "position",
              "intensity"
            ],
            "additionalProperties": false
          }
        },
        "measurementUncertainty": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "id",
        "name",
        "boundary",
        "subject",
        "obstacles",
        "lights",
        "measurementUncertainty"
      ],
      "additionalProperties": false
    },
    "gear": {
      "type": "object",
      "properties": {
        "lens": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "physical"
                },
                "focalLengthMm": {
                  "type": "number",
                  "minimum": 4,
                  "maximum": 600
                },
                "sensorWidthMm": {
                  "type": "number",
                  "minimum": 2,
                  "maximum": 100
                },
                "sensorHeightMm": {
                  "type": "number",
                  "minimum": 2,
                  "maximum": 100
                }
              },
              "required": [
                "kind",
                "focalLengthMm",
                "sensorWidthMm",
                "sensorHeightMm"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "equivalent"
                },
                "focalLengthMm": {
                  "type": "number",
                  "minimum": 4,
                  "maximum": 600
                }
              },
              "required": [
                "kind",
                "focalLengthMm"
              ],
              "additionalProperties": false
            }
          ]
        },
        "aspectRatio": {
          "type": "string",
          "enum": [
            "landscape",
            "portrait",
            "square"
          ]
        },
        "stabilizer": {
          "type": "string",
          "enum": [
            "handheld",
            "gimbal",
            "tripod",
            "slider"
          ]
        },
        "gimbalMode": {
          "type": "string",
          "enum": [
            "follow",
            "lock",
            "pov"
          ]
        },
        "cameraRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "operatorRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "operatorOffset": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "uncertaintyMargin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "maxHeight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "maxSpeed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        }
      },
      "required": [
        "lens",
        "aspectRatio",
        "stabilizer",
        "gimbalMode",
        "cameraRadius",
        "operatorRadius",
        "operatorOffset",
        "uncertaintyMargin",
        "minHeight",
        "maxHeight",
        "maxSpeed"
      ],
      "additionalProperties": false
    },
    "intent": {
      "type": "object",
      "properties": {
        "brief": {
          "default": "A controlled product hero shot",
          "type": "string",
          "maxLength": 4000
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 2,
          "maximum": 60
        },
        "framing": {
          "type": "string",
          "enum": [
            "wide",
            "medium",
            "close"
          ]
        },
        "motion": {
          "type": "string",
          "enum": [
            "subtle",
            "balanced",
            "dynamic"
          ]
        },
        "cameraHeight": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        },
        "framingTargets": {
          "type": "object",
          "properties": {
            "start": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "end": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "brief",
        "durationSeconds",
        "framing",
        "motion",
        "cameraHeight"
      ],
      "additionalProperties": false
    },
    "prompt": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "required": [
    "scene",
    "gear",
    "intent"
  ],
  "additionalProperties": false,
  "$id": "https://flowblock.local/schemas/1.0/planning-request.json"
}
