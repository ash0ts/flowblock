{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "flowblock-native-companion/1.0"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "planSchemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "coordinateFrame": {
      "type": "string",
      "const": "flowblock-y-up-meters"
    },
    "alignment": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unconfirmed",
            "aligned",
            "lost"
          ]
        },
        "nativeToPlan": {
          "type": "object",
          "properties": {
            "matrix": {
              "minItems": 16,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "order": {
              "type": "string",
              "const": "column-major"
            },
            "convention": {
              "type": "string",
              "const": "planPoint = nativeToPlan * nativePoint"
            },
            "scale": {
              "type": "number",
              "const": 1
            }
          },
          "required": [
            "matrix",
            "order",
            "convention",
            "scale"
          ],
          "additionalProperties": false
        },
        "referencePoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "native": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              "plan": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "native",
              "plan"
            ],
            "additionalProperties": false
          }
        },
        "horizontalUncertaintyMeters": {
          "type": "number",
          "minimum": 0
        },
        "verticalUncertaintyMeters": {
          "type": "number",
          "minimum": 0
        },
        "headingUncertaintyDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "confirmedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmedBy": {
          "type": "string",
          "enum": [
            "operator",
            "unconfirmed"
          ]
        }
      },
      "required": [
        "state",
        "nativeToPlan",
        "referencePoints",
        "horizontalUncertaintyMeters",
        "verticalUncertaintyMeters",
        "headingUncertaintyDegrees",
        "confirmedAt",
        "confirmedBy"
      ],
      "additionalProperties": false
    },
    "tracking": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "normal"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "limited"
            },
            "reason": {
              "type": "string",
              "enum": [
                "initializing",
                "excessive-motion",
                "insufficient-features",
                "relocalizing",
                "unknown"
              ]
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "unavailable"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "modeledGeometryValid": {
      "type": "boolean"
    },
    "durationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "samples": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timeSeconds": {
            "type": "number",
            "minimum": 0
          },
          "camera": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          },
          "target": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          },
          "operator": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          },
          "cameraEnvelopeRadius": {
            "type": "number",
            "minimum": 0
          },
          "operatorEnvelopeRadius": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "timeSeconds",
          "camera",
          "target",
          "operator",
          "cameraEnvelopeRadius",
          "operatorEnvelopeRadius"
        ],
        "additionalProperties": false
      }
    },
    "displayPolicy": {
      "type": "object",
      "properties": {
        "hideWorldAnchoredPathWhenTrackingLimited": {
          "type": "boolean",
          "const": true
        },
        "hideWorldAnchoredPathWhenAlignmentLost": {
          "type": "boolean",
          "const": true
        },
        "hideWorldAnchoredPathWhenModeledGeometryInvalid": {
          "type": "boolean",
          "const": true
        },
        "requireOperatorReconfirmationAfterRelocalization": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "hideWorldAnchoredPathWhenTrackingLimited",
        "hideWorldAnchoredPathWhenAlignmentLost",
        "hideWorldAnchoredPathWhenModeledGeometryInvalid",
        "requireOperatorReconfirmationAfterRelocalization"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "planSchemaVersion",
    "exportedAt",
    "coordinateFrame",
    "alignment",
    "tracking",
    "modeledGeometryValid",
    "durationSeconds",
    "samples",
    "displayPolicy",
    "limitations"
  ],
  "additionalProperties": false,
  "$id": "https://flowblock.local/schemas/1.0/ar-path-export.json"
}
