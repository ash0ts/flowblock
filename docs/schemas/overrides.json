{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "distance": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 30
    },
    "travel": {
      "type": "number",
      "minimum": 0,
      "maximum": 20
    },
    "bearingDeg": {
      "type": "number",
      "minimum": -360,
      "maximum": 360
    },
    "orbitDegrees": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "height": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 5
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 2,
      "maximum": 60
    },
    "reverse": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "$id": "https://flowblock.local/schemas/1.0/overrides.json"
}
