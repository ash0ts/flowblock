{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "flowblock-native-companion/1.0"
    },
    "captureId": {
      "type": "string",
      "minLength": 1
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "source": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "const": "ios"
        },
        "framework": {
          "type": "string",
          "const": "RoomPlan"
        },
        "appVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "platform",
        "framework",
        "appVersion"
      ],
      "additionalProperties": false
    },
    "coordinateFrame": {
      "type": "object",
      "properties": {
        "handedness": {
          "type": "string",
          "const": "right"
        },
        "upAxis": {
          "type": "string",
          "const": "+y"
        },
        "lengthUnit": {
          "type": "string",
          "const": "meter"
        },
        "origin": {
          "type": "string",
          "const": "capture-session-origin"
        }
      },
      "required": [
        "handedness",
        "upAxis",
        "lengthUnit",
        "origin"
      ],
      "additionalProperties": false
    },
    "tracking": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "normal"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "limited"
            },
            "reason": {
              "type": "string",
              "enum": [
                "initializing",
                "excessive-motion",
                "insufficient-features",
                "relocalizing",
                "unknown"
              ]
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "unavailable"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "alignment": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unconfirmed",
            "aligned",
            "lost"
          ]
        },
        "nativeToPlan": {
          "type": "object",
          "properties": {
            "matrix": {
              "minItems": 16,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "order": {
              "type": "string",
              "const": "column-major"
            },
            "convention": {
              "type": "string",
              "const": "planPoint = nativeToPlan * nativePoint"
            },
            "scale": {
              "type": "number",
              "const": 1
            }
          },
          "required": [
            "matrix",
            "order",
            "convention",
            "scale"
          ],
          "additionalProperties": false
        },
        "referencePoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "native": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              "plan": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "native",
              "plan"
            ],
            "additionalProperties": false
          }
        },
        "horizontalUncertaintyMeters": {
          "type": "number",
          "minimum": 0
        },
        "verticalUncertaintyMeters": {
          "type": "number",
          "minimum": 0
        },
        "headingUncertaintyDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "confirmedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmedBy": {
          "type": "string",
          "enum": [
            "operator",
            "unconfirmed"
          ]
        }
      },
      "required": [
        "state",
        "nativeToPlan",
        "referencePoints",
        "horizontalUncertaintyMeters",
        "verticalUncertaintyMeters",
        "headingUncertaintyDegrees",
        "confirmedAt",
        "confirmedBy"
      ],
      "additionalProperties": false
    },
    "floorBoundary": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "additionalProperties": false
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "obstacle",
              "product-candidate",
              "unclassified"
            ]
          },
          "nativeTransform": {
            "type": "object",
            "properties": {
              "matrix": {
                "minItems": 16,
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "order": {
                "type": "string",
                "const": "column-major"
              },
              "convention": {
                "type": "string",
                "const": "nativePoint = objectToNative * localPoint"
              }
            },
            "required": [
              "matrix",
              "order",
              "convention"
            ],
            "additionalProperties": false
          },
          "dimensionsMeters": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "depth": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "width",
              "height",
              "depth"
            ],
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "manual",
                  "roomplan",
                  "measured-device",
                  "assumed"
                ]
              },
              "measuredAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "captureId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "uncertaintyMeters": {
                "type": "number",
                "minimum": 0
              },
              "operatorVerified": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "measuredAt",
              "captureId",
              "uncertaintyMeters",
              "operatorVerified",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "label",
          "role",
          "nativeTransform",
          "dimensionsMeters",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "requiresOperatorReview": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "schemaVersion",
    "captureId",
    "capturedAt",
    "source",
    "coordinateFrame",
    "tracking",
    "alignment",
    "floorBoundary",
    "objects",
    "requiresOperatorReview"
  ],
  "additionalProperties": false,
  "$id": "https://flowblock.local/schemas/1.0/room-capture-import.json"
}
