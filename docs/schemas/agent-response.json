{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "actions": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "list_recipes"
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "compile_candidate"
              },
              "recipeId": {
                "type": "string",
                "enum": [
                  "hero-hold",
                  "elevated-hold",
                  "gentle-push",
                  "detail-push",
                  "context-pull",
                  "wide-pull",
                  "left-slide",
                  "right-slide",
                  "quarter-orbit",
                  "reverse-orbit",
                  "left-reveal",
                  "right-reveal"
                ]
              },
              "overrides": {
                "type": "object",
                "properties": {
                  "distance": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 30
                  },
                  "travel": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "bearingDeg": {
                    "type": "number",
                    "minimum": -360,
                    "maximum": 360
                  },
                  "orbitDegrees": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 5
                  },
                  "durationSeconds": {
                    "type": "number",
                    "minimum": 2,
                    "maximum": 60
                  },
                  "reverse": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "action",
              "recipeId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "validate_candidate"
              },
              "candidateId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "action",
              "candidateId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "read_take_findings"
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "propose_revision"
              },
              "overrides": {
                "type": "object",
                "properties": {
                  "distance": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 30
                  },
                  "travel": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "bearingDeg": {
                    "type": "number",
                    "minimum": -360,
                    "maximum": 360
                  },
                  "orbitDegrees": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 5
                  },
                  "durationSeconds": {
                    "type": "number",
                    "minimum": 2,
                    "maximum": 60
                  },
                  "reverse": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "findingIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "action",
              "overrides",
              "reason",
              "findingIds"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "finish"
              },
              "candidateIds": {
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "action",
              "candidateIds",
              "explanation"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "message",
    "actions"
  ],
  "additionalProperties": false,
  "$id": "https://flowblock.local/schemas/1.0/agent-response.json"
}
