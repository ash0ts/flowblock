# Local-only app. This bypass is restricted to localhost request hosts.
FLOWBLOCK_LOCAL_MODE=1
APP_URL=http://127.0.0.1:3037
POSTGRES_PASSWORD=replace-with-a-local-random-password
DATABASE_URL=postgresql://flowblock:replace-with-a-local-random-password@127.0.0.1:54379/flowblock
AUTH_SECRET=replace-with-a-local-random-secret
# Must be absolute: app and worker can have different working directories.
FLOWBLOCK_STORAGE_DIR=/absolute/path/to/flowblock/.data/media

# Optional Forge model APIs. Keep keys out of source control.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=flowblock
FLOWBLOCK_MODEL=openai/gpt-oss-20b
# FLOWBLOCK_INFERENCE_URL=https://api.inference.wandb.ai/v1
# FLOWBLOCK_TRACE=0

# Optional Google identity for a separately configured deployment.
# Set FLOWBLOCK_LOCAL_MODE=0 before exposing this app beyond your machine.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional private S3-compatible storage. Local use needs none of these.
S3_BUCKET=
S3_ENDPOINT=https://cwobject.com
AWS_REGION=US
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
